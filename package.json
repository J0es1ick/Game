{
  "name": "game",
  "version": "1.0.0",
  "description": "Однопользовательская RPG-симуляция живого мира с автоматическими боями на TypeScript",
  "main": "dist-console/index.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:console": "tsc -p tsconfig.console.json",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test -- --runInBand && npm run build:console && npm run build",
    "preview": "vite preview",
    "dev_con": "npm run build:console && node dist-console/index.js",
    "test": "jest"
  },
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20",
    "npm": ">=9"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3",
    "vite": "^8.1.3"
  },
  "jest": {
    "preset": "ts-jest",
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/tests/helpers/styleMock.ts"
    }
  }
}
