    "moduleResolution": "Node",
    "rootDir": "./src",
    "outDir": "./dist-console",
    "types": ["node"],
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/web", "tests", "node_modules", "dist", "dist-console"]
}
